+        Ok(path)
+    }
+
+    /// Resolution already removed `.` and `..` segments, so a prefix test is
+    /// lexical containment; an existing file is also checked after following links.
+    fn inside_allowed(&self, path: &Path) -> bool {
+        let allowed = [self.base.as_deref(), self.root.as_deref()];
+        let mut allowed = allowed.into_iter().flatten();
+        if !allowed.clone().any(|directory| path.starts_with(directory)) {
+            return false;
+        }
+        match path.canonicalize() {
+            Ok(real) => allowed.any(|directory| {
+                directory
+                    .canonicalize()
+                    .is_ok_and(|directory| real.starts_with(directory))
+            }),
+            // A missing file loads nothing; it reads as missing, not as escaped.
+            Err(_) => true,
+        }
     }
 
