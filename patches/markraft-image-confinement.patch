+    #[test]
+    fn confinement_keeps_local_images_inside_the_base_and_root() {
+        let mut images = Images::new(Some(PathBuf::from("/notes/posts")));
+        images.set_root(Ok(Some(PathBuf::from("/notes/posts"))));
+        images.set_confined(true);
+        assert_eq!(
+            images.resolve("img/test.png").unwrap(),
+            PathBuf::from("/notes/posts/img/test.png")
+        );
+        assert_eq!(
+            images.resolve("/img/test.png").unwrap(),
+            PathBuf::from("/notes/posts/img/test.png")
+        );
+        for escaping in [
+            "../test.png",
+            "img/../../other/test.png",
+            "file:///etc/test.png",
+            "file:///notes/test.png",
+        ] {
+            assert_eq!(
+                images.resolve(escaping),
+                Err(ImageError::InvalidPath),
+                "{escaping}"
+            );
+        }
+        images.set_confined(false);
+        assert_eq!(
+            images.resolve("../test.png").unwrap(),
+            PathBuf::from("/notes/test.png")
+        );
+    }
