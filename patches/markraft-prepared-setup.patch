+    /// Build immutable document state and analysis before creating the native view.
+    /// This owns no window or focus state and may run on a background executor.
+    pub fn prepare(self) -> PreparedSetup {
+        let Self {
+            schema,
+            types,
+            extensions,
+            kind,
+            doc,
+        } = self;
+        let (state, find) = build_state(&schema, &extensions, doc, &types);
+        let analysis = markraft_core::kind::analysis::DocumentAnalysis::new(
+            projection_of(&state),
+            &types,
+            Default::default(),
+        );
+        PreparedSetup {
+            types,
+            extensions,
+            kind,
+            state,
+            find,
+            analysis,
+        }
+    }
+}
