+#[cfg(test)]
+mod prepared_setup_tests {
+    use super::{EditorView, Setup};
+    use gpui::AppContext;
+
+    #[gpui::test]
+    fn background_setup_installs_the_exact_prepared_state(cx: &mut gpui::TestAppContext) {
+        let prepared = std::thread::spawn(|| {
+            let schema = markraft_commonmark::commonmark_schema();
+            let source =
+                markraft_commonmark::SourceDocument::parse(&schema, "# Ready\n\nA **note**.\n")
+                    .unwrap();
+            Setup::new(schema.clone())
+                .types(markraft_core::kind::DocTypes::from_schema_names(
+                    &schema,
+                    &markraft_commonmark::commonmark_doc_type_names(),
+                ))
+                .extensions(markraft_commonmark::commonmark_extensions(&schema))
+                .doc(source.document().clone())
+                .prepare()
+        })
+        .join()
+        .unwrap();
+        let state = prepared.state.clone();
+        let projection = markraft_core::projection::projection_of(&state);
+        let editor = cx.new(|cx| EditorView::from_prepared(prepared, cx));
+        editor.read_with(cx, |editor, _| {
+            assert!(editor.state().ptr_eq(&state));
+            assert!(std::sync::Arc::ptr_eq(
+                &markraft_core::projection::projection_of(editor.state()),
+                &projection
+            ));
+            assert_eq!(editor.state().doc(), state.doc());
+        });
+    }
+}
