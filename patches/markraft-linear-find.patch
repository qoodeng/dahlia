+#[cfg(test)]
+mod batch_search_tests {
+    use super::*;
+    #[test]
+    fn repeated_unicode_folds_keep_scalar_coordinates_after_every_match() {
+        let text = "中 İST cafe\u{301} 🙂 ".repeat(2048);
+        let count = text.chars().count();
+        let shown = ShownText {
+            text,
+            spans: (0..count).map(|i| i + 10..i + 11).collect(),
+            mappings: vec![CharacterMapping::Exact; count],
+            grapheme_boundaries: vec![true; count + 1],
+        };
+        let width = "中 İST cafe\u{301} 🙂 ".chars().count();
+        for (query, start, length) in [("ist", 2, 3), ("cafe", 6, 4), ("🙂", 12, 1)] {
+            let hits = shown.matches(query);
+            assert_eq!(hits.len(), 2048);
+            for (i, hit) in hits.into_iter().enumerate() {
+                assert_eq!(hit, i * width + start + 10..i * width + start + length + 10);
+            }
+        }
+    }
+}
