+/// A host that scales its geometry with the reading size replaces the fixed
+/// constants: code panel, cell padding, line heights and code size all follow
+/// the style, and the default style still draws what the constants did.
+#[test]
+fn host_geometry_replaces_the_fixed_constants() {
+    let source = "# Title\n\nBody\n\n```\ncode\n```\n\n| A | B |\n|---|---|\n| 1 | 2 |\n";
+    let defaults = EditorStyle::notes();
+    assert_eq!(defaults.code_padding, super::CODE_PADDING);
+    assert_eq!(defaults.code_inset, CODE_INSET);
+    assert_eq!(defaults.cell_padding_x, CELL_PADDING_X);
+    assert_eq!(defaults.quote_bar_width, QUOTE_BAR);
+    for reading_size in [9., 12., 24., 48.] {
+        let em = |k: f32| px((reading_size * k).round());
+        let style = EditorStyle {
+            body_size: px(reading_size),
+            line_height_ratio: 1.25,
+            heading_line_height_ratio: Some(1.1),
+            code_line_height_ratio: Some(1.3),
+            code_size: Some(px(reading_size * 0.875)),
+            code_padding: em(0.8),
+            code_inset: em(0.6),
+            cell_padding_x: em(0.6),
+            cell_padding_y: em(0.33),
+            ..EditorStyle::notes()
+        };
+        let rows = per_line(source, &style, |input, index, _| {
+            super::shape_line(input, index, px(600.), None, &text_system())
+        });
+        let heading = &rows[0];
+        assert_eq!(heading.line_height, style.heading_sizes[0] * 1.1);
+        let body = rows
+            .iter()
+            .find(|row| row.rows[0].text() == "Body")
+            .unwrap();
+        assert_eq!(body.line_height, px(reading_size) * 1.25);
+        let code = rows
+            .iter()
+            .find(|row| row.rows[0].text() == "code")
+            .unwrap();
+        assert_eq!(code.code_inset, em(0.6));
+        assert_eq!(code.code_padding, em(0.8));
+        assert_eq!(code.line_height, px(reading_size * 0.875) * 1.3);
+        assert_eq!(code.origin.x - code.code_padding, body.origin.x);
+    }
+}
