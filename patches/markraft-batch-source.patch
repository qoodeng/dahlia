+    #[test]
+    fn batched_source_preserves_bytes_and_matches_whole_parsing_at_every_boundary() {
+        let schema = commonmark_schema();
+        for newline in ["\n", "\r\n"] {
+            let body: String = (0..160)
+                .map(|i| match i % 4 {
+                    0 => format!("heading {i}\n==========\n\n"),
+                    1 => format!("needle **bold** {i}\n\n"),
+                    2 => format!("- needle item {i}\n- other item\n\n"),
+                    _ => format!("```rust\nneedle {i}\n```\n\n"),
+                })
+                .collect();
+            let original =
+                format!("\u{feff}---\nopaque: keep\n---\n\n{body}").replace('\n', newline);
+            let expected = original.replace("needle", "pin");
+            let baseline = SourceDocument::parse(&schema, &original).unwrap();
+            let whole = SourceDocument::parse(&schema, &expected).unwrap();
+            let next = baseline.render_batched(&schema, whole.document()).unwrap();
+            assert_eq!(next.source, expected);
+            assert_eq!(next.read, whole.read);
+            assert_eq!(next.blocks, whole.blocks);
+            let track = super::SourceTrack::new(baseline);
+            assert_eq!(track.write(&schema, whole.document()).unwrap(), expected);
+            assert_eq!(track.save(&schema, whole.document()).unwrap(), expected);
+            assert_eq!(
+                track.write(&schema, track.origin().document()).unwrap(),
+                original
+            );
+        }
+    }
+    #[test]
+    fn batched_source_falls_back_for_definitions_numbering_and_structural_edits() {
+        let schema = commonmark_schema();
+        let filler = "needle\n\n".repeat(80);
+        for tail in ["[ref]: /needle\n", "1. needle\n", ""] {
+            let original = format!("{filler}{tail}");
+            let baseline = SourceDocument::parse(&schema, &original).unwrap();
+            let edited = if tail.is_empty() {
+                original.replacen("needle", "# heading", 1)
+            } else {
+                original.replace("needle", "pin")
+            };
+            let parsed = SourceDocument::parse(&schema, &edited).unwrap();
+            assert!(
+                baseline
+                    .render_batched(&schema, parsed.document())
+                    .is_none()
+            );
+            assert_eq!(baseline.render(&schema, parsed.document()).unwrap(), edited);
+        }
+    }
