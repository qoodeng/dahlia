++
++/// How the host answers AppKit's `applicationShouldTerminate:`.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub enum TerminationReply {
++    /// Refuse. During logout, restart or shutdown this aborts the whole operation.
++    Cancel,
++    /// Terminate now.
++    Now,
++    /// Not yet: the host must call `reply_to_termination` once it knows.
++    Later,
++}
++
++/// Decide how ordinary AppKit termination proceeds, on the main thread. Answer `Later`
++/// while saving, then call `reply_to_termination` when the save is acknowledged.
++pub fn set_termination_guard(
++    _main_thread: MainThreadMarker,
++    guard: impl FnMut() -> TerminationReply + 'static,
++) {
++    TERMINATION_GUARD.with(|slot| *slot.borrow_mut() = Some(Box::new(guard)));
++}
++
++/// Settle a termination that was answered `Later`: true quits, false abandons it.
++/// Call it outside any borrow of the app, because quitting runs the quit callbacks.
++pub fn reply_to_termination(_main_thread: MainThreadMarker, terminate: bool) {
++    unsafe {
++        let app = NSApplication::sharedApplication(nil);
++        let _: () = msg_send![app, replyToApplicationShouldTerminate: terminate.to_objc()];
++    }
++}
++
++extern "C" fn should_terminate(_: &mut Object, _: Sel, _: id) -> NSUInteger {
++    TERMINATION_GUARD.with(|slot| {
++        // A nested request must not bypass a save already being decided.
++        let Ok(mut guard) = slot.try_borrow_mut() else { return 0 };
++        match guard.as_mut().map_or(TerminationReply::Now, |guard| guard()) {
++            TerminationReply::Cancel => 0,
++            TerminationReply::Now => 1,
++            TerminationReply::Later => 2,
++        }
++    })
++}
