+pub(super) fn paint_metric_strikethrough(row: &LayoutLine, window: &mut Window) {
+    for inner in &row.rows {
+        let starts = inner.wrap_starts();
+        for strike in &inner.strikes {
+            for (index, &start) in starts.iter().enumerate() {
+                let end = starts.get(index + 1).copied().unwrap_or(inner.text().len());
+                let a = start.max(strike.range.start);
+                let b = end.min(strike.range.end);
+                if a >= b {
+                    continue;
+                }
+                let x = inner.line.unwrapped_layout.x_for_index(a);
+                let left = x - inner.line.unwrapped_layout.x_for_index(start);
+                let width = inner.line.unwrapped_layout.x_for_index(b) - x;
+                if width <= px(0.) {
+                    continue;
+                }
+                let visual = inner.visual_start + index;
+                window.paint_strikethrough(
+                    row.origin
+                        + point(
+                            left + row.row_shift(visual),
+                            row.visual_baseline(visual) - strike.lift,
+                        ),
+                    width,
+                    &strike.style,
+                );
+            }
+        }
+    }
+}
