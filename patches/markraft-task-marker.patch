+#[test]
+fn task_host_sizes_keep_nested_boxes_on_baseline_and_hit_areas_out_of_text() {
+    let source = "- [ ] Pending\n- [x] Done\n  - [ ] Nested pending\n  - [x] Nested done\n";
+    for reading_size in 9..=48 {
+        let style = EditorStyle {
+            body_size: px(reading_size as f32),
+            task_marker_size: Some(px(reading_size as f32 * 0.8)),
+            line_height_ratio: 1.2,
+            ..EditorStyle::notes()
+        };
+        let rows = per_line(source, &style, |input, index, _| {
+            super::shape_line(input, index, px(600.), None, &text_system())
+        });
+        assert_eq!(rows.len(), 4);
+        for (index, row) in rows.iter().enumerate() {
+            let visible = row.marker_bounds().unwrap();
+            let (checked, hit) = row.task_marker().unwrap();
+            assert_eq!(checked, index % 2 == 1);
+            assert!((visible.size.width / style.body_size - 0.8).abs() < 0.001);
+            assert_eq!(visible.size.width, visible.size.height);
+            assert!(hit.size.width >= px(14.) && hit.size.height >= px(14.));
+            assert!(hit.left() <= visible.left() && hit.right() >= visible.right());
+            assert!(hit.top() <= visible.top() && hit.bottom() >= visible.bottom());
+            assert!(
+                hit.right() < row.origin.x,
+                "task hit area must not cover text"
+            );
+            let baseline = row.origin.y + row.visual_baseline(0);
+            assert!((visible.center().y - (baseline - row.task_cap_height / 2.)).abs() < px(0.001));
+            assert_eq!(
+                row.rows.iter().any(|inner| !inner.strikes.is_empty()),
+                checked
+            );
+            assert!(
+                visible.left() >= px(0.),
+                "large boxes must fit the task gutter"
+            );
+        }
+        assert!(rows[2].origin.x > rows[0].origin.x);
+    }
+}
