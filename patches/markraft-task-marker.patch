+#[test]
+fn task_host_sizes_put_bullets_numbers_and_boxes_in_one_marker_column() {
+    let source = "- Bullet\n\n- [ ] Task\n\n1. Number\n";
+    for reading_size in 9..=48 {
+        let size = reading_size as f32;
+        let style = EditorStyle {
+            body_size: px(size),
+            task_marker_size: Some(px(size * 0.8)),
+            list_indent: px(size * 1.5),
+            line_height_ratio: 1.25,
+            ..EditorStyle::notes()
+        };
+        let rows = per_line(source, &style, |input, index, _| {
+            super::shape_line(input, index, px(600.), None, &text_system())
+        });
+        let marker = |text: &str| {
+            let row = rows
+                .iter()
+                .find(|row| row.rows.iter().any(|inner| inner.text().contains(text)))
+                .unwrap();
+            (row.origin, row.marker_bounds().unwrap())
+        };
+        let (bullet_text, bullet) = marker("Bullet");
+        let (task_text, task) = marker("Task");
+        let (number_text, number) = marker("Number");
+        // Bullet and task lists start their text on the same column (an
+        // ordered list moves right only when its widest number needs it)...
+        assert_eq!(bullet_text.x, task_text.x);
+        // ...a bullet is centred on the task box, horizontally and vertically...
+        assert!((bullet.center().x - task.center().x).abs() < px(0.01));
+        assert!(
+            (bullet.center().y - bullet_text.y - (task.center().y - task_text.y)).abs() < px(0.01)
+        );
+        // ...and a number ends where a box does, half a box before the text.
+        assert!(((number_text.x - number.right()) - (task_text.x - task.right())).abs() < px(0.01));
+        assert!((task_text.x - task.right() - px(size * 0.4)).abs() < px(0.01));
+        // The bullet scales with the text instead of staying a 5px dot.
+        assert!((bullet.size.width / px(size) - 0.36).abs() < 0.001);
+    }
+}
