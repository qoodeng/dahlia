+    /// [`Self::set_find_query`] with `hits` found by [`find_hits_in`] against this
+    /// document, so a large document is searched off the main thread. The host
+    /// must discard hits found against a document that has since changed.
+    pub fn set_find_results(
+        &mut self,
+        query: String,
+        hits: Vec<std::ops::Range<usize>>,
+        cx: &mut Context<Self>,
+    ) {
+        self.run_find(find::Command::Results { query, hits }, cx);
+    }
+
+    /// Every hit of the current query, in document order.
+    pub fn find_hits(&self) -> Vec<std::ops::Range<usize>> {
+        self.state
+            .field(&self.find)
+            .map(|found| found.hits().to_vec())
+            .unwrap_or_default()
+    }
+
+    /// The editor state without a find query, so a host can plan many edits against
+    /// it without every planned edit searching the whole document again.
+    pub fn state_without_find(&self) -> EditorState {
+        let clear = TransactionSpec::new()
+            .effect(find::effect(find::Command::Query(String::new())))
+            .add_to_history(false);
+        self.state
+            .update([clear])
+            .map(|transaction| transaction.state().clone())
+            .unwrap_or_else(|_| self.state.clone())
+    }
+
+    /// The node kinds this view reads the document with, as [`find_hits_in`] needs them.
+    pub fn doc_types(&self) -> DocTypes {
+        self.types.clone()
+    }
