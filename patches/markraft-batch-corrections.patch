+
+#[test]
+fn correction_round_shares_derived_data_but_never_reuses_it_for_another_document() {
+    struct RoundText(String);
+    let schema = shared_schema();
+    let paragraph = schema.node_id("paragraph").unwrap();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let initialized = calls.clone();
+    let observer = Correction::on_content(paragraph, move |cx| {
+        let derived = cx.memoized(|| {
+            initialized.fetch_add(1, Ordering::SeqCst);
+            RoundText(cx.doc.text_between(
+                cx.start_state.schema(),
+                0,
+                cx.doc.content_size(),
+                Some("\n"),
+                None,
+            ))
+        });
+        assert_eq!(
+            derived.0,
+            cx.doc.text_between(
+                cx.start_state.schema(),
+                0,
+                cx.doc.content_size(),
+                Some("\n"),
+                None
+            )
+        );
+        Vec::new()
+    });
+    let start = state(
+        doc(
+            &schema,
+            [
+                n(&schema, "paragraph", [t(&schema, "a")]),
+                n(&schema, "paragraph", [t(&schema, "b")]),
+            ],
+        ),
+        corrections([observer]),
+    );
+    let first = start
+        .update([TransactionSpec::new().changes([
+            Change::insert(
+                1,
+                Slice::from_fragment(Fragment::from_node(schema.text("x"))),
+            ),
+            Change::insert(
+                4,
+                Slice::from_fragment(Fragment::from_node(schema.text("y"))),
+            ),
+        ])])
+        .unwrap();
+    assert_eq!(
+        calls.load(Ordering::SeqCst),
+        1,
+        "one initialization for both paragraphs"
+    );
+    let _second = first
+        .state()
+        .update([TransactionSpec::new().changes([Change::insert(
+            1,
+            Slice::from_fragment(Fragment::from_node(schema.text("z"))),
+        )])])
+        .unwrap();
+    assert_eq!(
+        calls.load(Ordering::SeqCst),
+        2,
+        "the next document has a fresh cache"
+    );
+}
